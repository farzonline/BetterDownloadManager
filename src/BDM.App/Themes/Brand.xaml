<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- BDM brand resources that do not change with light/dark: the violet-to-cyan gradient, the per-feature colours and their tints.
       Generated by tools/gen-brand.py from the table at its top; edit that, not this file. -->

  <Color x:Key="Brand.From">#FF7C6CFF</Color>
  <Color x:Key="Brand.To">#FF22D3EE</Color>
  <LinearGradientBrush x:Key="Brush.Brand" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Brand.From}" Offset="0"/>
    <GradientStop Color="{StaticResource Brand.To}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.BrandH" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource Brand.From}" Offset="0"/>
    <GradientStop Color="{StaticResource Brand.To}" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="Effect.Raised" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
  <DropShadowEffect x:Key="Effect.Glow" BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="#7C6CFF"/>

  <Color x:Key="Hue.Indigo">#FF6D5DF6</Color>
