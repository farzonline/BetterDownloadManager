<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Vector illustrations for empty states. Translucent brand colours only, so they read on both the dark and the light theme. -->

  <LinearGradientBrush x:Key="Art.Gradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF7C6CFF" Offset="0"/>
    <GradientStop Color="#FF22D3EE" Offset="1"/>
  </LinearGradientBrush>

  <!-- A download card with an arrow badge, circling dots -->
  <DrawingImage x:Key="Art.EmptyDownloads">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.ClipGeometry><RectangleGeometry Rect="0,0,200,160"/></DrawingGroup.ClipGeometry>
        <GeometryDrawing Brush="#1F7C6CFF"><GeometryDrawing.Geometry><EllipseGeometry Center="100,82" RadiusX="76" RadiusY="68"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Brush="#6622D3EE" Thickness="1.5" DashStyle="{x:Static DashStyles.Dash}"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><EllipseGeometry Center="100,82" RadiusX="94" RadiusY="44"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#1F7C6CFF">
          <GeometryDrawing.Pen><Pen Brush="#997C6CFF" Thickness="2"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="48,34,96,78" RadiusX="14" RadiusY="14"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#667C6CFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="62,50,44,8" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#447C6CFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="62,66,68,6" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#447C6CFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="62,80,52,6" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Art.Gradient}"><GeometryDrawing.Geometry><EllipseGeometry Center="138,112" RadiusX="25" RadiusY="25"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Brush="White" Thickness="3.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><PathGeometry Figures="M138,100 L138,120 M129,112 L138,121 L147,112"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#9922D3EE"><GeometryDrawing.Geometry><EllipseGeometry Center="30,60" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#887C6CFF"><GeometryDrawing.Geometry><EllipseGeometry Center="172,40" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#6622D3EE"><GeometryDrawing.Geometry><EllipseGeometry Center="168,138" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- A clock face with a trailing arc -->
  <DrawingImage x:Key="Art.EmptyHistory">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.ClipGeometry><RectangleGeometry Rect="0,0,200,160"/></DrawingGroup.ClipGeometry>
        <GeometryDrawing Brush="#1F0EA5E9"><GeometryDrawing.Geometry><EllipseGeometry Center="100,80" RadiusX="72" RadiusY="68"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#140EA5E9">
          <GeometryDrawing.Pen><Pen Brush="#B30EA5E9" Thickness="3"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><EllipseGeometry Center="100,80" RadiusX="46" RadiusY="46"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Brush="{StaticResource Art.Gradient}" Thickness="5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><PathGeometry Figures="M100,52 L100,80 L120,92"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Brush="#8022D3EE" Thickness="2" StartLineCap="Round" EndLineCap="Round" DashStyle="{x:Static DashStyles.Dot}"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><PathGeometry Figures="M30,80 A70,70 0 0 1 100,10"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#990EA5E9"><GeometryDrawing.Geometry><EllipseGeometry Center="168,48" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#6622D3EE"><GeometryDrawing.Geometry><EllipseGeometry Center="30,128" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- A padlock -->
  <DrawingImage x:Key="Art.EmptyLock">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.ClipGeometry><RectangleGeometry Rect="0,0,200,160"/></DrawingGroup.ClipGeometry>
        <GeometryDrawing Brush="#1FF43F5E"><GeometryDrawing.Geometry><EllipseGeometry Center="100,82" RadiusX="72" RadiusY="66"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Brush="#B3F43F5E" Thickness="7" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><PathGeometry Figures="M78,76 L78,60 A22,22 0 0 1 122,60 L122,76"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#33F43F5E">
          <GeometryDrawing.Pen><Pen Brush="#F2F43F5E" Thickness="2.5"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="64,74,72,54" RadiusX="14" RadiusY="14"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#F2F43F5E"><GeometryDrawing.Geometry><EllipseGeometry Center="100,98" RadiusX="7" RadiusY="7"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#F2F43F5E"><GeometryDrawing.Geometry><RectangleGeometry Rect="97,100,6,16" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#99F43F5E"><GeometryDrawing.Geometry><EllipseGeometry Center="164,40" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#66EC4899"><GeometryDrawing.Geometry><EllipseGeometry Center="34,118" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
