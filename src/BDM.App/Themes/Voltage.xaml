  <Thickness x:Key="Space.1">4</Thickness>
  <Thickness x:Key="Space.2">8</Thickness>
  <Thickness x:Key="Space.3">12</Thickness>
  <Thickness x:Key="Space.4">16</Thickness>
  <Thickness x:Key="Space.5">20</Thickness>
  <Thickness x:Key="Space.6">24</Thickness>
  <Thickness x:Key="Space.7">32</Thickness>
  <Thickness x:Key="Space.8">40</Thickness>
  <FontFamily x:Key="Font.Display">Bahnschrift</FontFamily>
  <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Subtitle">15</sys:Double>
  <sys:Double x:Key="FontSize.Title">20</sys:Double>
  <sys:Double x:Key="FontSize.Display">28</sys:Double>
  <sys:Double x:Key="Motion.Fast">120</sys:Double>
