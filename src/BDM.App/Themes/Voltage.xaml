<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Voltage (dark). Generated by theme-studio emit.py; do not edit, re-run emit.py. -->
  <Color x:Key="Color.Background">#FF0B0C0D</Color>
  <Color x:Key="Color.BackgroundAlt">#FF121416</Color>
  <Color x:Key="Color.Surface">#FF15171A</Color>
  <Color x:Key="Color.SurfaceAlt">#FF101214</Color>
  <Color x:Key="Color.Raised">#FF1E2125</Color>
  <Color x:Key="Color.Line">#FF272B30</Color>
  <Color x:Key="Color.Selection">#FF2C3137</Color>
  <Color x:Key="Color.Text">#FFF2F5F3</Color>
  <Color x:Key="Color.TextMuted">#FF878D92</Color>
  <Color x:Key="Color.Accent">#FF04FA73</Color>
  <Color x:Key="Color.AccentHover">#FF02D863</Color>
  <Color x:Key="Color.AccentText">#FF04FA73</Color>
  <Color x:Key="Color.OnAccent">#FF02140A</Color>
