<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BDM.App</AssemblyName>
    <RootNamespace>BDM.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <!-- Drawn by tools/make-icon.py. The exe's own icon is what the taskbar, Start menu and shortcuts show. -->
    <ApplicationIcon>Assets\bdm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\bdm.ico" LogicalName="bdm.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only for the tray icon; keep its names out of WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BDM.Core\BDM.Core.csproj" />
  </ItemGroup>

</Project>
