<Window x:Class="BDM.App.Views.AddUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Download file info" Width="600" MinWidth="520" SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <DockPanel>
    <v:PageHeader x:Name="Header" DockPanel.Dock="Top" Glyph="&#xE710;" Hue="{StaticResource Hue.Indigo}" Title="Download file info" Subtitle="Check where it goes, then start it now or later."/>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <Button x:Name="DetailsButton" Content="Hide details" v:Ico.Glyph="&#xE70E;" HorizontalAlignment="Left" Click="Details_Click"
                ToolTip="Show only the address, category and where to save, or everything (BDM remembers your choice)"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="LaterButton" Content="Download later" v:Ico.Glyph="&#xE823;" Margin="0,0,8,0" Click="Later_Click" IsEnabled="False"/>
          <Button x:Name="NowButton" Content="Start download" v:Ico.Glyph="&#xE896;" Style="{StaticResource Style.Button.Accent}" IsDefault="True" Click="Now_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Margin="24,20,24,22" VerticalAlignment="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="Address" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
      <TextBox x:Name="UrlBox" Grid.Column="2" TextChanged="UrlBox_TextChanged" AutomationProperties.Name="Download address" ToolTip="http, https or ftp address"/>
      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0" MinHeight="18">
        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="Info" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="440" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>

      <TextBlock Grid.Row="3" Text="Category" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
      <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal">
      <ComboBox x:Name="CategoryBox" MinWidth="220" SelectionChanged="CategoryBox_SelectionChanged" AutomationProperties.Name="Category">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Converter={x:Static v:CategoryGlyphConverter.Instance}}" FontFamily="{DynamicResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{Binding Converter={x:Static v:CategoryBrushConverter.Instance}}"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Connections" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="20,0,10,0"/>
      <ComboBox x:Name="ConnectionsBox" MinWidth="120" AutomationProperties.Name="Connections"
                ToolTip="How many parts to fetch at once. Some free file hosts (Hotlink) allow only 1; BDM drops the ones a server refuses anyway."/>
      </StackPanel>

      <TextBlock Grid.Row="5" Text="Save as" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
      <Grid Grid.Row="5" Grid.Column="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" FontFamily="{DynamicResource Font.Mono}" TextChanged="PathBox_TextChanged" AutomationProperties.Name="Save as"/>
        <Button Grid.Column="1" Content="Browse…" v:Ico.Glyph="&#xE838;" Margin="8,0,0,0" Click="Browse_Click"/>
      </Grid>
      <CheckBox x:Name="RememberBox" Grid.Row="6" Grid.Column="2" Margin="0,8,0,0" Content="Remember this folder for the category"/>

      <TextBlock x:Name="DescriptionLabel" Grid.Row="8" Text="Description" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
      <TextBox x:Name="DescriptionBox" Grid.Row="8" Grid.Column="2" AutomationProperties.Name="Description" ToolTip="Your own note, shown in the list"/>
      <TextBlock x:Name="ProxyLabel" Grid.Row="9" Text="Route through" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,12,0,0"/>
      <ComboBox x:Name="ProxyBox" Grid.Row="9" Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,12,0,0" AutomationProperties.Name="Route through"/>
      <CheckBox x:Name="PageBox" Grid.Row="10" Grid.Column="2" Margin="0,12,0,0" Content="This is a video page: let yt-dlp find the video" AutomationProperties.Name="Treat as a video page"
                Checked="PageBox_Changed" Unchecked="PageBox_Changed"/>
    </Grid>
  </DockPanel>
</Window>
