<Window x:Class="BDM.App.Views.AddUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Add a download" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel>
    <v:PageHeader Glyph="&#xE710;" Hue="{StaticResource Hue.Indigo}" Title="Add a download" Subtitle="Paste a link. BDM splits it into parts and fetches them in parallel."/>
    <StackPanel Margin="24,20,24,22">
      <TextBlock Text="Address" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
      <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" AutomationProperties.Name="Download address" ToolTip="http, https or ftp address"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0" MinHeight="18">
        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="Info" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="470" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <CheckBox x:Name="PageBox" Margin="0,16,0,0" Content="This is a video page: let yt-dlp find the video" AutomationProperties.Name="Treat as a video page"/>
      <TextBlock Text="Route through" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
      <ComboBox x:Name="ProxyBox" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Route through"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="&#xE838;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="Folder" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
      </StackPanel>
    </StackPanel>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
        <Button x:Name="LaterButton" Content="Download later" v:Ico.Glyph="&#xE823;" Margin="0,0,8,0" Click="Later_Click" IsEnabled="False"/>
        <Button x:Name="NowButton" Content="Download now" v:Ico.Glyph="&#xE896;" Style="{StaticResource Style.Button.Accent}" IsDefault="True" Click="Now_Click" IsEnabled="False"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
