<Window x:Class="BDM.App.Views.AddUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a download" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel Margin="24">
    <TextBlock Text="Add a download" Style="{StaticResource Text.Title}"/>
    <TextBlock Text="Address" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
    <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" AutomationProperties.Name="Download address" ToolTip="http, https or ftp address"/>
    <TextBlock x:Name="Info" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" MinHeight="16" TextTrimming="CharacterEllipsis"
               AutomationProperties.LiveSetting="Polite"/>
    <CheckBox x:Name="PageBox" Margin="0,16,0,0" Content="This is a video page: let yt-dlp find the video" AutomationProperties.Name="Treat as a video page"/>
    <TextBlock Text="Route through" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
    <ComboBox x:Name="ProxyBox" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Route through"/>
    <TextBlock x:Name="Folder" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="LaterButton" Content="Download later" Margin="0,0,8,0" Click="Later_Click" IsEnabled="False"/>
      <Button x:Name="NowButton" Content="Download now" Style="{StaticResource Style.Button.Accent}" IsDefault="True" Click="Now_Click" IsEnabled="False"/>
    </StackPanel>
  </StackPanel>
</Window>
