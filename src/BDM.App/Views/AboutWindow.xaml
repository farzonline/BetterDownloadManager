<Window x:Class="BDM.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="About Better Download Manager" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel>
    <v:PageHeader Glyph="&#xE946;" Hue="{StaticResource Hue.Violet}" Title="About"/>
    <StackPanel Margin="24,24,24,26" HorizontalAlignment="Center">
      <Image x:Name="Logo" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Better Download Manager" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,14,0,2"/>
      <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
      <TextBlock Text="A fast download manager for Windows, with a browser extension that catches the videos on a page."
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" Margin="0,16,0,0"/>
      <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0">
        <Run Text="Made by" Foreground="{DynamicResource Brush.TextMuted}"/>
        <Run Text="Farzonline" FontWeight="SemiBold"/>
      </TextBlock>
    </StackPanel>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"/>
    </Border>
  </StackPanel>
</Window>
