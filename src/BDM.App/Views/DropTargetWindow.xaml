<Window x:Class="BDM.App.Views.DropTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drop links" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Width="72" Height="72" AllowDrop="True"
        DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop" MouseLeftButtonDown="Window_MouseDown">
  <Border x:Name="Box" Margin="4" CornerRadius="14" Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" ToolTip="Drop links here to download them. Drag to move; double-click to hide.">
    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource Font.Icon}" FontSize="28"
               Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
</Window>
