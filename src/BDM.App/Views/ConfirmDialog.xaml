<Window x:Class="BDM.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better Download Manager" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel Margin="24">
    <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" TextWrapping="Wrap"/>
    <TextBlock x:Name="Body" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
    <CheckBox x:Name="Option" Margin="0,16,0,0" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="ConfirmButton" Click="Confirm_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
