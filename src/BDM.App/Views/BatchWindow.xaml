<Window x:Class="BDM.App.Views.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Batch download" Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel>
    <v:PageHeader Glyph="&#xE8FD;" Hue="{StaticResource Hue.Violet}" Title="Batch download"
                  Subtitle="Use [001-100] for numbers and [a-z] for letters in the address, like photo[001-050].jpg"/>
    <StackPanel Margin="24,20,24,22">
      <TextBlock Text="Address pattern" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
      <TextBox x:Name="PatternBox" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Address pattern" FontFamily="{DynamicResource Font.Mono}"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <TextBlock Text="&#xE783;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,6,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Foreground="{DynamicResource Brush.Danger}" Text="{Binding Error}" TextWrapping="Wrap" MaxWidth="480" AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
      <Border Style="{StaticResource Style.Card}" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource Brush.SurfaceAlt}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource Font.Icon}" FontSize="14" Foreground="{StaticResource Hue.Violet.Brush}" Margin="0,0,8,0"/>
            <TextBlock x:Name="CountText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding PreviewLines}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
        <Button x:Name="AddButton" Content="Add to downloads" v:Ico.Glyph="&#xE710;" Style="{StaticResource Style.Button.Accent}" IsDefault="True" Click="Add_Click" IsEnabled="False"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
