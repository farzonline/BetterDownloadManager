<Window x:Class="BDM.App.Views.CompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Download complete" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel>
    <v:PageHeader x:Name="Header" Glyph="&#xE73E;" Hue="{StaticResource Hue.Emerald}" Title="Download complete"/>
    <Border Style="{StaticResource Style.Card}" Padding="16,10" Margin="24,20,24,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <TextBlock Text="&#xE774;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Sky.Brush}"/>
        <TextBlock Grid.Column="1" Text="Address" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
        <TextBlock x:Name="UrlText" Grid.Column="2" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="&#xE838;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Amber.Brush}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Saved as" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
        <TextBlock x:Name="PathText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="&#xE7B8;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Violet.Brush}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Size" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <CheckBox x:Name="DontShow" Content="Don't show this window again" Margin="24,14,24,18"
              ToolTip="You can turn it back on in Options"/>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Open" v:Ico.Glyph="&#xE8E5;" Style="{StaticResource Style.Button.Accent}" Margin="0,0,8,0" Click="Open_Click" IsDefault="True"/>
        <Button Content="Open with…" v:Ico.Glyph="&#xE7AC;" Margin="0,0,8,0" Click="OpenWith_Click"/>
        <Button Content="Open folder" v:Ico.Glyph="&#xE838;" Margin="0,0,8,0" Click="Folder_Click"/>
        <Button Content="Close" IsCancel="True" Click="Close_Click"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
