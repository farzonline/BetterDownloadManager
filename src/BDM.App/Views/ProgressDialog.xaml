<Window x:Class="BDM.App.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Download" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel>
    <v:PageHeader Glyph="&#xE896;" Hue="{StaticResource Hue.Indigo}" Title="{Binding Name}" Subtitle="{Binding StatusText}"/>
    <StackPanel Margin="24,20,24,22">
      <Grid>
        <TextBlock Text="{Binding PercentText}" FontFamily="{DynamicResource Font.Display}" FontSize="{DynamicResource FontSize.Display}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
      </Grid>
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="8" Margin="0,8,0,0"/>
      <Canvas x:Name="Segments" Height="10" Margin="0,12,0,0" ClipToBounds="True" ToolTip="Connections: each bar is one part of the file"/>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Style.Card}" Padding="14,12">
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Hue.Sky.Tint}">
              <TextBlock Text="&#xE9D2;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Foreground="{StaticResource Hue.Sky.Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Speed" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding SpeedText}" FontWeight="SemiBold" MinHeight="18"/></StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="14,12">
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Hue.Amber.Tint}">
              <TextBlock Text="&#xE823;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Foreground="{StaticResource Hue.Amber.Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Time left" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding EtaText}" FontWeight="SemiBold" MinHeight="18"/></StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
        <TextBlock Text="&#xE774;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Url}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="&#xE838;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SaveTo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PauseResume" Content="Pause" v:Ico.Glyph="&#xE769;" Margin="0,0,8,0" Click="PauseResume_Click"/>
        <Button Content="Close" IsCancel="True" IsDefault="True"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
