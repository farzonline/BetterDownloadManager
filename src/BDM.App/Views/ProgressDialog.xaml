<Window x:Class="BDM.App.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Download" Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar"/>
  </Window.TaskbarItemInfo>
  <StackPanel>
    <v:PageHeader x:Name="Header" Glyph="&#xE896;" Hue="{StaticResource Hue.Indigo}" Title="{Binding Name}" Subtitle="{Binding StatusText}"/>
    <StackPanel Margin="24,20,24,22">
      <TextBlock Text="{Binding PercentText}" FontFamily="{DynamicResource Font.Display}" FontSize="{DynamicResource FontSize.Display}" FontWeight="SemiBold"/>
      <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="8" Margin="0,8,0,0"/>
      <Canvas x:Name="Segments" Height="10" Margin="0,10,0,0" ClipToBounds="True" ToolTip="Connections: each bar is one part of the file, fetched in parallel"/>

      <!-- IDM's "Download status" table -->
      <Border Style="{StaticResource Style.Card}" Padding="16,10" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="&#xE946;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Indigo.Brush}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Status" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
          <TextBlock Grid.Row="1" Text="&#xE7B8;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Violet.Brush}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="File size" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SizeValue" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Text="&#xE896;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Emerald.Brush}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Downloaded" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DownloadedValue" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="3" Text="&#xE9D2;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Sky.Brush}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Transfer rate" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="4" Text="&#xE823;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Amber.Brush}"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="Time left" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding EtaText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="5" Text="&#xE8CE;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Teal.Brush}"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Connections" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="5" Grid.Column="2" x:Name="ConnectionsValue" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- IDM's per-connection table: one row per part of the file -->
      <Border x:Name="PartsCard" Style="{StaticResource Style.Card}" Padding="4,4,4,6" Margin="0,12,0,0">
        <ListView x:Name="Parts" Height="150" Background="Transparent" BorderThickness="0" Focusable="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Connections">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
              <Setter Property="MinHeight" Value="26"/>
              <Setter Property="Focusable" Value="False"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="N." Width="44"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Number}" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn Header="Downloaded" Width="190" DisplayMemberBinding="{Binding Downloaded}"/>
              <GridViewColumn Header="Rate" Width="110" DisplayMemberBinding="{Binding Rate}"/>
              <GridViewColumn Header="Info" Width="200">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Status}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Receiving data"><Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Finished"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <TextBlock Text="&#xE774;" Style="{StaticResource Text.MenuIcon}"/>
        <TextBlock Grid.Column="1" Text="{Binding Url}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="&#xE838;" Style="{StaticResource Text.MenuIcon}"/>
        <TextBlock x:Name="SaveTo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <Button Content="To tray" v:Ico.Glyph="&#xE921;" HorizontalAlignment="Left" Click="Tray_Click"
                ToolTip="Hide this window to the notification area; click its icon there to bring it back"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PauseResume" Content="Pause" v:Ico.Glyph="&#xE769;" Margin="0,0,8,0" Click="PauseResume_Click"/>
          <Button Content="Close" IsCancel="True" Click="Close_Click" ToolTip="Closing this window doesn't stop the download"/>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</Window>
