<Window x:Class="BDM.App.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Download" Width="620" MinWidth="480" SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <Window.Resources>
    <!-- IDM's tabs: a strip of choices with the current one underlined -->
    <Style x:Key="Style.Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Padding="14,8" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="6,6,0,0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Raised}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar"/>
  </Window.TaskbarItemInfo>
  <DockPanel>
    <v:PageHeader x:Name="Header" DockPanel.Dock="Top" Glyph="&#xE896;" Hue="{StaticResource Hue.Indigo}" Title="{Binding Name}" Subtitle="{Binding StatusText}"/>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="DetailsButton" Content="Hide details" v:Ico.Glyph="&#xE70E;" Margin="0,0,8,0" Click="Details_Click"
                  ToolTip="Show only the progress, or all the details (BDM remembers your choice)"/>
          <Button Content="To tray" v:Ico.Glyph="&#xE921;" Click="Tray_Click"
                  ToolTip="Hide this window to the notification area; click its icon there to bring it back"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PauseResume" Content="Pause" v:Ico.Glyph="&#xE769;" Margin="0,0,8,0" Click="PauseResume_Click"/>
          <Button Content="Close" IsCancel="True" Click="Close_Click" ToolTip="Closing this window doesn't stop the download"/>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel Margin="24,20,24,22">
      <TextBlock DockPanel.Dock="Top" Text="{Binding PercentText}" FontFamily="{DynamicResource Font.Display}" FontSize="{DynamicResource FontSize.Display}" FontWeight="SemiBold"/>
      <ProgressBar DockPanel.Dock="Top" x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="8" Margin="0,8,0,0"/>
      <Canvas DockPanel.Dock="Top" x:Name="Segments" Height="10" Margin="0,10,0,0" ClipToBounds="True" ToolTip="Connections: each bar is one part of the file, fetched in parallel"/>

      <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <TextBlock Text="&#xE774;" Style="{StaticResource Text.MenuIcon}"/>
        <TextBlock Grid.Column="1" Text="{Binding Url}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="&#xE838;" Style="{StaticResource Text.MenuIcon}"/>
        <TextBlock x:Name="SaveTo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
      <!-- Everything below the bars; "Hide details" folds it away -->
      <DockPanel x:Name="Details">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
        <RadioButton x:Name="StatusTab" Content="Status" GroupName="Tabs" Style="{StaticResource Style.Tab}" IsChecked="True" Checked="Tab_Checked"/>
        <RadioButton x:Name="SpeedTab" Content="Speed limiter" GroupName="Tabs" Style="{StaticResource Style.Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="FinishTab" Content="Options on completion" GroupName="Tabs" Style="{StaticResource Style.Tab}" Checked="Tab_Checked"/>
      </StackPanel>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Line}"/>

      <!-- All three pages share one cell, so the window keeps its size when switching -->
      <Grid>
      <DockPanel x:Name="StatusPage">
      <!-- IDM's "Download status" table -->
      <Border DockPanel.Dock="Top" Style="{StaticResource Style.Card}" Padding="16,10" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="&#xE946;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Indigo.Brush}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Status" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
          <TextBlock Grid.Row="1" Text="&#xE7B8;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Violet.Brush}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="File size" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SizeValue" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Text="&#xE896;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Emerald.Brush}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Downloaded" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DownloadedValue" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="3" Text="&#xE9D2;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Sky.Brush}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Transfer rate" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="4" Text="&#xE823;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Amber.Brush}"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="Time left" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding EtaText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="5" Text="&#xE8CE;" Style="{StaticResource Text.MenuIcon}" Foreground="{StaticResource Hue.Teal.Brush}"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Connections" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="5" Grid.Column="2" x:Name="ConnectionsValue" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- IDM's per-connection table: one row per part of the file -->
      <Border x:Name="PartsCard" Style="{StaticResource Style.Card}" Padding="4,4,4,6" Margin="0,12,0,0">
        <ListView x:Name="Parts" Height="150" Background="Transparent" BorderThickness="0" Focusable="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Connections">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
              <Setter Property="MinHeight" Value="26"/>
              <Setter Property="Focusable" Value="False"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="N." Width="44"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Number}" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn Header="Downloaded" Width="190" DisplayMemberBinding="{Binding Downloaded}"/>
              <GridViewColumn Header="Rate" Width="110" DisplayMemberBinding="{Binding Rate}"/>
              <GridViewColumn Header="Info" Width="200">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Status}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Receiving data"><Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Finished"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
      </DockPanel>

      <StackPanel x:Name="SpeedPage" Margin="4,18,4,0" Visibility="Hidden">
        <CheckBox x:Name="LimitBox" Content="Limit this download's speed" Checked="Limit_Changed" Unchecked="Limit_Changed"/>
        <StackPanel Orientation="Horizontal" Margin="26,14,0,0">
          <TextBlock Text="Maximum" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBox x:Name="LimitKb" Width="110" Text="500" LostFocus="Limit_Changed" KeyDown="LimitKb_KeyDown" AutomationProperties.Name="Maximum speed in KB per second"/>
          <TextBlock Text="KB/s" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="LimitNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="26,14,0,0"
                   Text="Takes effect straight away, on top of the overall limit in Options. Handy for keeping the connection free for other things."/>
      </StackPanel>

      <StackPanel x:Name="FinishPage" Margin="4,18,4,0" Visibility="Hidden">
        <CheckBox x:Name="ShowCompleteBox" Content="Show “Download complete” when it finishes"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <TextBlock Text="When it finishes" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="WhenDoneBox" MinWidth="260" SelectedIndex="0" AutomationProperties.Name="When it finishes">
            <ComboBoxItem Content="Do nothing"/>
            <ComboBoxItem Content="Exit Better Download Manager"/>
            <ComboBoxItem Content="Put the computer to sleep"/>
            <ComboBoxItem Content="Hibernate the computer"/>
            <ComboBoxItem Content="Shut down the computer"/>
          </ComboBox>
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Text="Only for this download, and only while this window is open (or in the tray). Shutting down waits 30 seconds, so you can still stop it with “shutdown /a”."/>
      </StackPanel>
      </Grid>
      </DockPanel>
    </DockPanel>
  </DockPanel>
</Window>
