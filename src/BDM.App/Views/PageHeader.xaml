<UserControl x:Class="BDM.App.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The identity of a window: its own colour wash, a big faint copy of its icon, and the icon on a gradient tile. -->
  <Border x:Name="Frame" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" ClipToBounds="True" MinHeight="88">
    <Grid>
      <Border x:Name="Wash"/>
      <TextBlock x:Name="Mark" FontFamily="{DynamicResource Font.Icon}" FontSize="132" Opacity="0.12" IsHitTestVisible="False"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,-26"/>
      <StackPanel Orientation="Horizontal" Margin="24,16,24,16" VerticalAlignment="Center">
        <Border x:Name="Tile" Width="52" Height="52" CornerRadius="16">
          <Border.Effect><DropShadowEffect x:Name="TileGlow" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/></Border.Effect>
          <TextBlock x:Name="Icon" FontFamily="{DynamicResource Font.Icon}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="440" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
