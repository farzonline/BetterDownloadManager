<Window x:Class="BDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Better Download Manager" Width="1160" Height="720" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}"
        StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- One download as a card: file-type tile, name, state line, progress, numbers -->
    <DataTemplate x:Key="DownloadRow">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="14" VerticalAlignment="Center" Background="{Binding CategoryHue, Converter={x:Static v:HueBrushConverter.Instance}, ConverterParameter=Tint}">
          <TextBlock Text="{Binding CategoryGlyph}" FontFamily="{DynamicResource Font.Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding CategoryHue, Converter={x:Static v:HueBrushConverter.Instance}, ConverterParameter=Brush}"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock x:Name="StateIcon" Text="{Binding StateGlyph}" FontFamily="{DynamicResource Font.Icon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBlock x:Name="StateText" Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" MaxWidth="560"/>
          </StackPanel>
          <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="104">
          <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding EtaText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StateKind}" Value="running">
          <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
          <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKind}" Value="done">
          <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
          <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
          <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKind}" Value="failed">
          <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
          <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
          <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKind}" Value="protected">
          <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
          <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
          <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKind}" Value="paused">
          <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Progress}" Value="-1">
          <Setter TargetName="Bar" Property="IsIndeterminate" Value="True"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Sidebar: tinted with the brand colour at the top, its top band is the left half of the title bar -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource Brush.BackgroundAlt}"/>
    <Border Grid.Column="0" Grid.RowSpan="2" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#2E7C6CFF" Offset="0"/>
          <GradientStop Color="#0A22D3EE" Offset="0.6"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="18,0,8,0" VerticalAlignment="Center">
      <Image x:Name="Crest" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="BETTER" Style="{StaticResource Text.Section}" FontSize="10"/>
        <TextBlock Text="Download Manager" FontFamily="{DynamicResource Font.Display}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
      </StackPanel>
    </StackPanel>
    <Grid Grid.Column="0" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="LIBRARY" Style="{StaticResource Text.Section}" Margin="26,14,0,6"/>
      <ListBox Grid.Row="1" x:Name="Nav" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
               ItemContainerStyle="{StaticResource Style.NavItem}" Background="Transparent" BorderThickness="0"
               AutomationProperties.Name="Categories" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      <!-- Live status card -->
      <Border Grid.Row="2" Margin="14,8,14,14" Style="{StaticResource Style.Card}" Padding="14,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Brush.Brand}" VerticalAlignment="Center">
            <TextBlock Text="&#xE9D2;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Right now" Style="{StaticResource Text.Section}" FontSize="10"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Brush.Line}"/>

    <!-- Content: toolbar band (the right half of the title bar) -->
    <Grid Grid.Column="2" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Command="{Binding AddUrlCommand}" Style="{StaticResource Style.Button.Accent}" ToolTip="Add a download (Ctrl+N)" Margin="0,0,14,0" Padding="14,0,18,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Add URL" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border Style="{StaticResource Style.Card}" Padding="3" CornerRadius="13">
          <StackPanel Orientation="Horizontal">
            <Button Content="&#xE768;" Command="{Binding ResumeCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Resume" AutomationProperties.Name="Resume"/>
            <Button Content="&#xE769;" Command="{Binding PauseCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Pause" AutomationProperties.Name="Pause"/>
            <Button Content="&#xE74D;" Command="{Binding RemoveCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Remove (Delete)" AutomationProperties.Name="Remove"/>
            <Border Width="1" Height="18" Margin="4,0" Background="{DynamicResource Brush.Line}"/>
            <Button Content="&#xE8E5;" Command="{Binding OpenFileCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Open file" AutomationProperties.Name="Open file"/>
            <Button Content="&#xE838;" Command="{Binding OpenFolderCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Show in folder" AutomationProperties.Name="Show in folder"/>
            <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource Style.Button.Icon}" ToolTip="More" AutomationProperties.Name="More" Click="More_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <Border Grid.Column="2" Width="240" Height="36" Margin="0,0,14,0" Style="{StaticResource Style.Card}" Padding="0" CornerRadius="18" WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid>
          <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search downloads (Ctrl+F)"
                   AutomationProperties.Name="Search downloads" Background="Transparent" BorderThickness="0" Padding="38,0,14,0" Height="34"/>
          <TextBlock Text="Search" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinButton" Content="&#xE921;" Style="{StaticResource Style.Button.Chrome}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Min_Click"/>
        <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource Style.Button.Chrome}" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Max_Click"/>
        <Button Content="&#xE8BB;" Style="{StaticResource Style.Button.ChromeClose}" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <!-- Downloads -->
    <Grid Grid.Column="2" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border x:Name="Banner" Visibility="Collapsed" Margin="18,6,18,0" Padding="16,12" CornerRadius="{DynamicResource Radius.Box}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="BannerIcon" Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" x:Name="BannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel x:Name="BannerActions" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"/>
          <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource Style.Button.Icon}" Width="28" Height="28" Margin="8,-4,-8,-4" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="BannerClose_Click"/>
        </Grid>
      </Border>

      <ListView Grid.Row="1" x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                Margin="0,8,0,0" AutomationProperties.Name="Downloads" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick"
                ItemContainerStyle="{StaticResource Style.CardRow}" ItemTemplate="{StaticResource DownloadRow}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListView.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Command="{Binding OpenFileCommand}"><MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Text.MenuIcon}"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="Show in folder" Command="{Binding OpenFolderCommand}"><MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Text.MenuIcon}"/></MenuItem.Icon></MenuItem>
            <Separator/>
            <MenuItem Header="Resume" Command="{Binding ResumeCommand}"><MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Text.MenuIcon}"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="Pause" Command="{Binding PauseCommand}"><MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Text.MenuIcon}"/></MenuItem.Icon></MenuItem>
            <Separator/>
            <MenuItem Header="Copy address" Click="CopyAddress_Click"><MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Text.MenuIcon}"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="Remove…" Command="{Binding RemoveCommand}"><MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Text.MenuIcon}"/></MenuItem.Icon></MenuItem>
          </ContextMenu>
        </ListView.ContextMenu>
      </ListView>

      <!-- Empty state -->
      <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Image Source="{StaticResource Art.EmptyDownloads}" Width="240" Height="192" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Nothing here yet" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,4,0,4"/>
        <TextBlock Text="Paste a link, drop one on the floating target, or let the browser extension catch it." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"/>
        <Button Command="{Binding AddUrlCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" Style="{StaticResource Style.Button.Accent}" Padding="18,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Add URL" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
