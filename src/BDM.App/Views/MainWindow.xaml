<Window x:Class="BDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better Download Manager" Width="1120" Height="680" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}"
        StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <!-- Sidebar: its top band is the left half of the title bar -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource Brush.BackgroundAlt}"/>
    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
      <Image x:Name="Crest" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Better Download Manager" FontFamily="{DynamicResource Font.Display}" FontSize="{DynamicResource FontSize.Subtitle}"
                 FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="192"/>
    </StackPanel>
    <Grid Grid.Column="0" Grid.Row="1" Background="{DynamicResource Brush.BackgroundAlt}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="LIBRARY" Style="{StaticResource Text.Section}" Margin="24,16,0,4"/>
      <ListBox Grid.Row="1" x:Name="Nav" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
               ItemContainerStyle="{StaticResource Style.NavItem}" Background="Transparent" BorderThickness="0"
               AutomationProperties.Name="Categories" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
    <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Brush.Line}"/>

    <!-- Content: toolbar band (the right half of the title bar) -->
    <Grid Grid.Column="2" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="Add URL" Command="{Binding AddUrlCommand}" Style="{StaticResource Style.Button.Accent}" ToolTip="Add a download (Ctrl+N)" Margin="0,0,12,0"/>
        <Button Content="&#xE768;" Command="{Binding ResumeCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Resume" AutomationProperties.Name="Resume"/>
        <Button Content="&#xE769;" Command="{Binding PauseCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Pause" AutomationProperties.Name="Pause"/>
        <Button Content="&#xE74D;" Command="{Binding RemoveCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Remove (Delete)" AutomationProperties.Name="Remove"/>
        <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource Brush.Line}"/>
        <Button Content="&#xE8E5;" Command="{Binding OpenFileCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Open file" AutomationProperties.Name="Open file"/>
        <Button Content="&#xE838;" Command="{Binding OpenFolderCommand}" Style="{StaticResource Style.Button.Icon}" ToolTip="Show in folder" AutomationProperties.Name="Show in folder"/>
      </StackPanel>
      <Grid Grid.Column="2" Width="220" Height="32" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search downloads (Ctrl+F)"
                 AutomationProperties.Name="Search downloads" Padding="10,0,10,0"/>
        <TextBlock Text="Search" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinButton" Content="&#xE921;" Style="{StaticResource Style.Button.Chrome}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Min_Click"/>
        <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource Style.Button.Chrome}" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Max_Click"/>
        <Button Content="&#xE8BB;" Style="{StaticResource Style.Button.ChromeClose}" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <!-- Downloads -->
    <Grid Grid.Column="2" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border x:Name="Banner" Visibility="Collapsed" Margin="16,8,16,0" Padding="16,12" CornerRadius="{DynamicResource Radius.Box}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel x:Name="BannerActions" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"/>
          <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource Style.Button.Icon}" Width="28" Height="28" Margin="8,-4,-8,-4" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="BannerClose_Click"/>
        </Grid>
      </Border>

      <ListView Grid.Row="1" x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                Margin="0,8,0,0" AutomationProperties.Name="Downloads" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" SizeChanged="List_SizeChanged">
        <ListView.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Command="{Binding OpenFileCommand}"/>
            <MenuItem Header="Show in folder" Command="{Binding OpenFolderCommand}"/>
            <Separator/>
            <MenuItem Header="Resume" Command="{Binding ResumeCommand}"/>
            <MenuItem Header="Pause" Command="{Binding PauseCommand}"/>
            <Separator/>
            <MenuItem Header="Copy address" Click="CopyAddress_Click"/>
            <MenuItem Header="Remove…" Command="{Binding RemoveCommand}"/>
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn x:Name="NameCol" Header="Name" Width="380">
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Size" Width="88">
              <GridViewColumn.HeaderContainerStyle><Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></GridViewColumn.HeaderContainerStyle>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Progress" Width="120">
              <GridViewColumn.CellTemplate><DataTemplate><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="12,0"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Status" Width="190">
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="0,0,12,0"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Speed" Width="88">
              <GridViewColumn.HeaderContainerStyle><Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></GridViewColumn.HeaderContainerStyle>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Left" Width="72">
              <GridViewColumn.HeaderContainerStyle><Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></GridViewColumn.HeaderContainerStyle>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EtaText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Added" Width="132">
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AddedText}" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <!-- Empty state -->
      <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource Font.Icon}" FontSize="32" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
        <TextBlock Text="No downloads here yet." Margin="0,12,0,12" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
        <Button Content="Add URL" Command="{Binding AddUrlCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource Brush.BackgroundAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="RightStatus" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
