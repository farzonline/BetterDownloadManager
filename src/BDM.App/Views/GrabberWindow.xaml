<Window x:Class="BDM.App.Views.GrabberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Site grabber" Width="700" Height="720" MinHeight="500" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <v:PageHeader Glyph="&#xE774;" Hue="{StaticResource Hue.Teal}" Title="Site grabber" Subtitle="Scan a page for files and add the ones you pick."/>
  <Grid Grid.Row="1" Margin="24,18,24,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <TextBlock Text="Page to scan" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
      <TextBox x:Name="UrlBox" Text="{Binding StartUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Page to scan"/>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Link depth" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/><TextBox Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Link depth"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Only these types (zip jpg mp4)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/><TextBox Text="{Binding IncludeExtensions, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File types to include"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="Skip these types" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/><TextBox Text="{Binding ExcludeExtensions, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File types to skip"/></StackPanel>
      </Grid>
      <Grid Margin="0,12,0,12">
        <CheckBox Content="Stay on this site" IsChecked="{Binding SameHostOnly}" VerticalAlignment="Center"/>
        <Button x:Name="ScanButton" Content="Scan" v:Ico.Glyph="&#xE721;" HorizontalAlignment="Right" Click="Scan_Click"/>
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel.Visibility><Binding Path="Results.Count" Converter="{x:Static v:ZeroToVisible.Instance}"/></StackPanel.Visibility>
      <Image Source="{StaticResource Art.EmptyDownloads}" Width="200" Height="160"/>
      <TextBlock Text="Scan a page to see its files" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center"/>
    </StackPanel>
    <ListBox Grid.Row="2" x:Name="ResultsList" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
             ItemContainerStyle="{StaticResource Style.ListBoxItem}" AutomationProperties.Name="Files found" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Url}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="540"/>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
        <Button Content="Select none" Click="SelectNone_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" IsCancel="True" Margin="0,0,8,0"/>
        <Button x:Name="AddButton" Content="Add selected" v:Ico.Glyph="&#xE710;" Style="{StaticResource Style.Button.Accent}" Click="Add_Click" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
  </Grid>
</Window>
