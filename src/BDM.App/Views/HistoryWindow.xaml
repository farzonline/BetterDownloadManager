<Window x:Class="BDM.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download history" Width="860" Height="560" MinHeight="380" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <TextBlock Text="Download history" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search by name or address" AutomationProperties.Name="Search history"/>
    </Grid>
    <ListView Grid.Row="1" x:Name="List" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" Margin="0,16,0,0"
              AutomationProperties.Name="History" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn Header="Name" Width="240"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="Status" Width="170"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="0,0,12,0"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="Added" Width="130"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AddedText}" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="Address" Width="300"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Url}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="CountText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
      <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</Window>
