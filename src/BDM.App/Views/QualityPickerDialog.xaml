<Window x:Class="BDM.App.Views.QualityPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose quality" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel Margin="24">
    <TextBlock Text="Choose a quality" Style="{StaticResource Text.Title}"/>
    <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" TextTrimming="CharacterEllipsis"/>
    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" MaxHeight="240"
             ItemContainerStyle="{StaticResource Style.NavItem}" DisplayMemberPath="Label"
             AutomationProperties.Name="Available qualities" MouseDoubleClick="List_DoubleClick"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="Ok" Content="Download" Style="{StaticResource Style.Button.Accent}" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
