<Window x:Class="BDM.App.Views.QualityPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BDM.App.Views"
        Title="Choose quality" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}">
  <StackPanel>
    <v:PageHeader x:Name="Header" Glyph="&#xE714;" Hue="{StaticResource Hue.Pink}" Title="Choose a quality"/>
    <StackPanel Margin="24,18,24,22">
      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" MaxHeight="260"
               ItemContainerStyle="{StaticResource Style.ChoiceItem}"
               AutomationProperties.Name="Available qualities" MouseDoubleClick="List_DoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE714;" FontFamily="{DynamicResource Font.Icon}" FontSize="14" Foreground="{StaticResource Hue.Pink.Brush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
        <Button x:Name="Ok" Content="Download" v:Ico.Glyph="&#xE896;" Style="{StaticResource Style.Button.Accent}" IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
